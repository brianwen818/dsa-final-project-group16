<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.group16</groupId>
	<artifactId>ooosearch</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ooosearch</name>
	<description>假面騎士OOO 搜尋引擎 — Data Structure Final Project Group 16</description>

	<properties>
		<java.version>21</java.version>
		<jsoup.version>1.21.1</jsoup.version>
		<exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
	</properties>

	<dependencies>
		<!-- 抓網頁、解析 HTML -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>${jsoup.version}</version>
		</dependency>

		<!-- Stage 5 網站（只有 web/ package 可以使用 Spring） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- 測試（JUnit 5） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Stage 3、4 需要時再加入：Selenium、HanLP／jieba-analysis -->
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.group16.ooosearch.web.OooSearchApplication</mainClass>
				</configuration>
			</plugin>
			<!-- 執行各 Stage 的命令列 Demo：mvnw exec:java -Dexec.mainClass=com.group16.ooosearch.cli.Stage1Main -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>${exec-maven-plugin.version}</version>
			</plugin>
		</plugins>
	</build>

</project>
